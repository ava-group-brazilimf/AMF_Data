{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTask",
  "description": "Contrato de entrada padrão para todos os agentes da Migration Factory",
  "type": "object",
  "required": ["trace_id", "agent_id", "description"],
  "properties": {
    "trace_id": { "type": "string", "format": "uuid" },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string", "minLength": 10 },
    "context": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string" },
        "wave_id": { "type": "string" },
        "source_platform": { "type": "string" },
        "target_platform": { "type": "string" },
        "previous_output": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
