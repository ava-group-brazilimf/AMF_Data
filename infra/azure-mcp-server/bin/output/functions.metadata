        "properties": {}
      },
      {
        "name": "databricksHost",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "databricks_host",
        "propertyType": "string",
        "description": "The Databricks workspace URL (e.g., adb-123456.14.azuredatabricks.net)",
        "properties": {}
      },
      {
        "name": "databricksToken",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "databricks_token",
        "propertyType": "string",
        "description": "The Databricks Personal Access Token",
        "properties": {}
      },
      {
        "name": "warehouseName",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "warehouse_name",
        "propertyType": "string",
        "description": "Name for the SQL Warehouse",
        "properties": {}
      },
      {
        "name": "clusterSize",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "cluster_size",
        "propertyType": "string",
        "description": "Size of the cluster: 2X-Small, X-Small, Small, Medium, Large",
        "properties": {}
      },
      {
        "name": "autoStopMins",
        "direction": "In",
        "type": "mcpToolProperty",
        "propertyName": "auto_stop_mins",
        "propertyType": "integer",
        "description": "Minutes of inactivity before auto-stop",
        "properties": {}
      }
    ]
