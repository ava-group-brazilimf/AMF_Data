  {
    "name": "CreateSqlWarehouse",
    "scriptFile": "azure-mcp-server.dll",
    "entryPoint": "AzureMcpServer.DatabricksTools.CreateSqlWarehouse",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "context",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "create_sql_warehouse",
